<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.EC2" Version="4.0.102" />
    <PackageReference Include="AWSSDK.RDS" Version="4.0.102" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.2" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101.2" />
  </ItemGroup>

</Project>
