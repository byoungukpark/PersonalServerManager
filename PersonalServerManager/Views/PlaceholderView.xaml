<UserControl x:Class="PersonalServerManager.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,40">
            <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="현재 단계의 화면 구성입니다."
                       Margin="0,7,0,28" Foreground="{StaticResource MutedTextBrush}" />

            <Border Style="{StaticResource SurfaceCardStyle}" MinHeight="400" Padding="30">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="520">
                    <Border Width="70" Height="70" CornerRadius="20"
                            Background="{StaticResource SubtleSurfaceBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,22">
                        <TextBlock Text="◇" FontSize="36" FontFamily="Segoe UI Symbol"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="기능 준비 중" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding Description}" Margin="0,10,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
