<UserControl x:Class="PersonalServerManager.Views.GroupDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PersonalServerManager.Views"
             Foreground="{StaticResource PrimaryTextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ResourceDiscovery.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,40" MaxWidth="1100" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Name}" FontSize="27" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="저장된 그룹 구성, 기본 AWS 상태와 CloudWatch 지표를 확인합니다."
                               Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="그룹 관리" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenManagementCommand}" IsEnabled="{Binding CanOpenManagement}"
                            Margin="0,0,10,0" />
                    <Button Content="그룹 삭제" Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{StaticResource ErrorBrush}"
                            Command="{Binding DeleteCommand}" Margin="0,0,10,0" />
                    <Button Content="새로고침" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    <Button Content="대시보드로" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BackToDashboardCommand}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="그룹 삭제를 처리하는 중입니다…" Margin="0,0,0,16"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding IsDeleting, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="그룹 구성을 불러오는 중입니다…" Margin="0,0,0,16"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Background="{StaticResource SubtleSurfaceBrush}"
                    BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryTextBrush}" />
            </Border>

            <StackPanel Visibility="{Binding HasGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource GroupStatusBannerStyle}" Padding="16,12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   Style="{StaticResource GroupStatusBannerTextStyle}" />
                        <TextBlock Text="상태 갱신 중 · 이전 값 표시" Margin="0,5,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding IsStatusRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="AWS 연결 관리로 이동" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding GoToConnectionCommand}"
                                Visibility="{Binding HasAccessIssue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="그룹 정보" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16" />
                        <WrapPanel>
                            <StackPanel Width="300" Margin="0,0,20,14">
                                <TextBlock Text="AWS 계정 ID" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding AccountId}" Margin="0,5,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Width="260" Margin="0,0,20,14">
                                <TextBlock Text="그룹 리전" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Region}" Margin="0,5,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Width="260" Margin="0,0,20,14">
                                <TextBlock Text="등록 시 프로필" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding ProfileName}" Margin="0,5,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Ec2CountText}" Margin="0,0,22,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding RdsCountText}" Margin="0,0,22,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding S3CountText}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="그룹 전체 제어" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="EC2와 RDS를 저장된 순서로 시작하고 역순으로 중지합니다. 각 자원의 실제 상태를 확인한 뒤 다음 단계로 진행합니다."
                                   Margin="0,6,0,16" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="그룹 시작" Command="{Binding StartGroupCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="그룹 중지" Command="{Binding StopGroupCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="실행 전 대상과 순서를 확인합니다. 진행과 단계별 결과는 화면 아래에 표시됩니다."
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <TabControl SelectedIndex="{Binding SelectedContentTabIndex}"
                            Style="{StaticResource ResourceTabControlStyle}">
                    <TabItem Header="리소스 상세 · 개별 제어">
                        <StackPanel>
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="등록 리소스" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="등록된 리소스가 없습니다." Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResources}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TabControl SelectedIndex="{Binding SelectedServiceIndex}" Margin="0,0,0,12"
                                    Style="{StaticResource ResourceTabControlStyle}">
                            <TabItem Header="EC2" />
                            <TabItem Header="RDS" />
                            <TabItem Header="S3" />
                        </TabControl>
                        <TextBox Text="{Binding ResourceSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WizardTextBoxStyle}"
                                 ToolTip="이름 또는 식별자 검색" Margin="0,0,0,12" />
                        <Grid Height="{Binding ResourcePanelHeight}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="160" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" MinHeight="140" />
                            </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding FilteredResources}"
                                  SelectedItem="{Binding SelectedResource, Mode=TwoWay}" SelectionMode="Single"
                                  Style="{StaticResource ResourceDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="서비스" Binding="{Binding Kind}" Width="100" />
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="식별자" Binding="{Binding Id}" Width="2*" MinWidth="180" />
                                <DataGridTextColumn Header="리전" Binding="{Binding Region}" Width="180" />
                                <DataGridTemplateColumn Header="현재 상태" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayStatus}" VerticalAlignment="Center"
                                                       Style="{StaticResource GroupStatusTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                      Background="{StaticResource StrokeBrush}" />
                        <Border Grid.Row="2" Background="{StaticResource SubtleSurfaceBrush}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsControlSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Content="시작" Command="{Binding StartCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="중지" Command="{Binding StopCommand}" Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="재부팅 (EC2)" Command="{Binding RebootCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="시작 순서" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="EC2와 RDS의 저장된 순서입니다. 그룹 중지는 이 순서의 역순입니다."
                                   Margin="0,5,0,14" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="시작 순서 대상이 없습니다." Margin="0,0,0,8"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasStartOrder}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding StartOrder}"
                                  Style="{StaticResource ResourceDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  MaxHeight="300" EnableRowVirtualization="True"
                                  Visibility="{Binding HasStartOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="순서" Binding="{Binding Position}" Width="80" />
                                <DataGridTextColumn Header="서비스" Binding="{Binding Kind}" Width="100" />
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="식별자" Binding="{Binding Id}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="그룹 모니터링">
                        <views:GroupMonitoringView DataContext="{Binding Monitoring}" />
                    </TabItem>
                </TabControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
