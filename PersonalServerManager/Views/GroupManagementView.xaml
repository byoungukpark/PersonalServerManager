<UserControl x:Class="PersonalServerManager.Views.GroupManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource PrimaryTextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ResourceDiscovery.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="36,30,36,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="그룹 관리" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="그룹 이름·연결 자원·시작 순서를 편집합니다. 저장 전까지 AWS 자원이나 로컬 설정은 바뀌지 않습니다."
                       Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SubtleSurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8"
                Padding="14,10" Margin="0,0,0,16"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource ResourceTabControlStyle}">
            <TabItem Header="기본 정보">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="그룹 이름" Style="{StaticResource WizardLabelStyle}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WizardTextBoxStyle}" MaxLength="50" Margin="0,7,0,22" />
                        <TextBlock Text="AWS 계정 ID" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Text="{Binding AccountId}" Margin="0,7,0,18" />
                        <TextBlock Text="그룹 리전 · 변경 불가" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Text="{Binding Region}" Margin="0,7,0,18" />
                        <TextBlock Text="등록 시 프로필 · 변경 불가" Style="{StaticResource WizardLabelStyle}" />
                        <TextBlock Text="{Binding ProfileName}" Margin="0,7,0,18" />
                        <TextBlock Text="AWS 프로필 변경은 왼쪽의 AWS 연결 관리에서 진행합니다."
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="리소스 관리">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="체크된 자원은 그룹에 연결됩니다. 체크를 해제해도 AWS 자원은 중지·삭제되지 않습니다."
                                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Text="새 자원 조회는 이 그룹의 AWS 계정에 연결한 경우에만 가능합니다. 조회 목록에 없는 기존 연결도 유지됩니다."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
                        <ContentControl Grid.Row="2" Content="{Binding}"
                                        ContentTemplate="{StaticResource SharedResourceSelectionTemplate}" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="시작 순서">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="EC2·RDS 시작 순서입니다. 그룹 중지는 이 순서의 역순입니다."
                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ListBox x:Name="OrderList" ItemsSource="{Binding StartOrder}"
                                     SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                                     Style="{StaticResource WizardOrderListStyle}" AllowDrop="True"
                                     PreviewMouseLeftButtonDown="OrderList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="OrderList_PreviewMouseMove" Drop="OrderList_Drop" MinHeight="240">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Padding="8,5" />
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <Button Content="위로" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,9" />
                                <Button Content="아래로" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Health">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="EC2별 애플리케이션 Health" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="인증 없는 HTTP/HTTPS 주소를 등록합니다. EC2 상태와 앱 응답은 별도로 표시됩니다."
                                   Margin="0,6,0,16" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="연결된 EC2" />
                        <ComboBox ItemsSource="{Binding Ec2Choices}" SelectedItem="{Binding HealthEc2}"
                                  DisplayMemberPath="Name" Margin="0,6,0,12" MinWidth="300" HorizontalAlignment="Left" />
                        <TextBlock Text="앱 이름" />
                        <TextBox Text="{Binding NewHealthName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WizardTextBoxStyle}" Margin="0,6,0,12" MaxLength="80" />
                        <TextBlock Text="Health URL" />
                        <TextBox Text="{Binding NewHealthUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource WizardTextBoxStyle}" Margin="0,6,0,12" />
                        <TextBlock Text="판정 규칙: Http2xx / Json / StatusUp" />
                        <ComboBox ItemsSource="{Binding HealthRules}" SelectedItem="{Binding NewHealthRule}"
                                  Margin="0,6,0,12" HorizontalAlignment="Left" MinWidth="180" />
                        <Button Content="앱 추가" Command="{Binding AddHealthCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,18" />
                        <ItemsControl ItemsSource="{Binding HealthApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                            Padding="12" Margin="0,0,0,9" CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Ec2Id}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="앱 이름" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Health URL" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <ComboBox ItemsSource="{Binding DataContext.HealthRules, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding Rule}" MinWidth="150" />
                                                <Button Content="제거" Margin="12,0,0,0"
                                                        Command="{Binding DataContext.RemoveHealthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="로그 설정">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="24" Margin="0,16,0,0">
                    <TextBlock Text="CloudWatch 로그 연결 설정은 후속 구현 예정입니다."
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
            <Button Content="그룹 삭제" DockPanel.Dock="Left" Command="{Binding DeleteCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource ErrorBrush}" />
            <Button Content="변경사항 저장" DockPanel.Dock="Right" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" />
            <Button Content="취소 · 그룹 상세로" DockPanel.Dock="Right" Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</UserControl>
