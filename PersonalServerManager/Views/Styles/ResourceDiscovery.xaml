<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WizardLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="WizardTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="WizardCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBoxBorder" Width="18" Height="18"
                                CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource StrokeBrush}"
                                Background="{StaticResource SurfaceBrush}"
                                VerticalAlignment="Center" />
                        <Path x:Name="CheckMark" Width="18" Height="18" Stretch="None"
                              VerticalAlignment="Center" Data="M 4,9 L 7.5,12.5 L 14,5"
                              Stroke="{StaticResource SidebarBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed" />
                        <ContentPresenter Grid.Column="1" ContentSource="Content"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="CheckBoxBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResourceSelectionCheckBoxStyle" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource WizardCheckBoxStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="WizardChoiceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style x:Key="WizardPrimaryButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WizardOrderListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <Style x:Key="ResourceTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder" Background="{StaticResource SubtleSurfaceBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="9" Margin="0,0,8,0" Padding="22,10">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background"
                                    Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background"
                                    Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResourceTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ResourceTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel IsItemsHost="True" Margin="0,0,0,14"
                                  KeyboardNavigation.TabIndex="1" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ResourceDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResourceDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResourceDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResourceDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleSurfaceBrush}" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="42" />
        <Setter Property="ColumnHeaderHeight" Value="42" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ResourceDataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource ResourceDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource ResourceDataGridCellStyle}" />
    </Style>
    <!-- 상태 문구가 길어져도 다음 열에 가리지 않도록 줄바꿈한다. -->
    <Style x:Key="ResourceStatusTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 그룹 생성과 그룹 편집이 같은 조회/선택 표를 사용한다. -->
    <BooleanToVisibilityConverter x:Key="ResourceBoolVisibility" />
    <DataTemplate x:Key="SharedResourceSelectionTemplate">
        <TabControl Style="{StaticResource ResourceTabControlStyle}"
                    SelectedIndex="{Binding SelectedResourceTabIndex, Mode=TwoWay}">
            <TabItem Header="EC2" Visibility="{Binding IncludeEc2, Converter={StaticResource ResourceBoolVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,13">
                        <Button Content="EC2 목록 조회" DockPanel.Dock="Right" Style="{StaticResource WizardPrimaryButtonStyle}"
                                Command="{Binding QueryEc2Command}" />
                        <TextBlock Text="{Binding Ec2Status}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Ec2Choices}" Style="{StaticResource ResourceDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              MinHeight="{Binding ResourceTableMinHeight}" MaxHeight="420" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox Style="{StaticResource ResourceSelectionCheckBoxStyle}"
                                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding CanSelect}" ToolTip="{Binding RegistrationText}"
                                                            HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="Instance ID" Binding="{Binding Id}" Width="190" />
                            <DataGridTextColumn Header="유형" Binding="{Binding Detail}" Width="100" />
                            <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="205"
                                                ElementStyle="{StaticResource ResourceStatusTextStyle}" />
                            <DataGridTextColumn Header="등록 정보" Binding="{Binding RegistrationText}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="RDS" Visibility="{Binding IncludeRds, Converter={StaticResource ResourceBoolVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,13">
                        <Button Content="RDS 목록 조회" DockPanel.Dock="Right" Style="{StaticResource WizardPrimaryButtonStyle}"
                                Command="{Binding QueryRdsCommand}" />
                        <TextBlock Text="{Binding RdsStatus}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RdsChoices}" Style="{StaticResource ResourceDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              MinHeight="{Binding ResourceTableMinHeight}" MaxHeight="420" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox Style="{StaticResource ResourceSelectionCheckBoxStyle}"
                                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding CanSelect}" ToolTip="{Binding RegistrationText}"
                                                            HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DB Identifier" Binding="{Binding Id}" Width="280" />
                            <DataGridTextColumn Header="엔진" Binding="{Binding Detail}" Width="130" />
                            <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="205"
                                                ElementStyle="{StaticResource ResourceStatusTextStyle}" />
                            <DataGridTextColumn Header="등록 정보" Binding="{Binding RegistrationText}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="S3" Visibility="{Binding IncludeS3, Converter={StaticResource ResourceBoolVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,13">
                        <Button Content="S3 버킷 조회" DockPanel.Dock="Right" Style="{StaticResource WizardPrimaryButtonStyle}"
                                Command="{Binding QueryS3Command}" />
                        <TextBlock Text="{Binding S3Status}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding S3Choices}" Style="{StaticResource ResourceDataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              MinHeight="{Binding ResourceTableMinHeight}" MaxHeight="420" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox Style="{StaticResource ResourceSelectionCheckBoxStyle}"
                                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding CanSelect}" ToolTip="{Binding RegistrationText}"
                                                            HorizontalAlignment="Center" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="버킷" Binding="{Binding Name}" Width="470" />
                            <DataGridTextColumn Header="버킷 리전" Binding="{Binding Region}" Width="180" />
                            <DataGridTextColumn Header="등록 정보" Binding="{Binding RegistrationText}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DataTemplate>
</ResourceDictionary>
