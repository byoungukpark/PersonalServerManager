<UserControl x:Class="PersonalServerManager.Views.GroupMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:local="clr-namespace:PersonalServerManager.Views"
             Foreground="{StaticResource PrimaryTextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/GroupMonitoring.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:PlotModelFactoryConverter x:Key="PlotModelFactoryConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,18,0,0">
        <DockPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ListBox ItemsSource="{Binding MetricLayouts}" SelectedItem="{Binding SelectedLayout}"
                         ItemContainerStyle="{StaticResource MetricLayoutItemStyle}"
                         Style="{StaticResource MetricLayoutPickerStyle}" Margin="0,0,12,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ComboBox ItemsSource="{Binding MetricRanges}" SelectedItem="{Binding SelectedRange}"
                          DisplayMemberPath="Label" Width="105" Margin="0,0,8,0"
                          Style="{StaticResource AppComboBoxStyle}" />
                <Button Content="지표 새로고침" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="그룹 모니터링" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="그룹에 등록된 모든 리소스의 CloudWatch 지표입니다."
                           Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>
        <TextBlock Text="S3 저장량·객체 수는 일 단위 지표이며, 선택한 시간 범위와 관계없이 최근 자료를 표시합니다."
                   Margin="0,0,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Text="{Binding ErrorMessage}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{StaticResource ErrorBrush}" />
        <TextBlock Text="등록된 리소스가 없습니다." Foreground="{StaticResource MutedTextBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResources}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Identity}" Margin="0,4,0,8"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,8"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Charts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="{Binding DataContext.ChartColumns, RelativeSource={RelativeSource AncestorType={x:Type local:GroupMonitoringView}}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource MetricCardStyle}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource MetricStatusBadgeStyle}"
                                                            Visibility="{Binding HasStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding StatusBadge}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource SurfaceBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LatestText}" FontSize="17"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,6,0,2" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MeasuredAtText}" FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <oxy:PlotView Model="{Binding PlotFactory, Converter={StaticResource PlotModelFactoryConverter}}" Height="190" Margin="0,10,0,0"
                                                              PreviewMouseWheel="PlotView_OnPreviewMouseWheel"
                                                              Background="{StaticResource SurfaceBrush}"
                                                              Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Border Height="190" Margin="0,10,0,0" BorderThickness="1"
                                                        BorderBrush="{StaticResource StrokeBrush}"
                                                        Visibility="{Binding IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="상태 검사 측정값 없음" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
