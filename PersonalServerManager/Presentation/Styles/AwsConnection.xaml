<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ConnectionErrorBrush" Color="#F48787" />
    <SolidColorBrush x:Key="ConnectionErrorSurfaceBrush" Color="#3A262B" />
    <SolidColorBrush x:Key="ConnectionSuccessBrush" Color="#8BE0BA" />
    <SolidColorBrush x:Key="ConnectionSuccessSurfaceBrush" Color="#203B35" />

    <Style x:Key="ConnectionPrimaryButtonStyle" TargetType="{x:Type Button}"
           BasedOn="{StaticResource PrimaryButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
