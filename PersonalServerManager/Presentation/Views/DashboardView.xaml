<UserControl x:Class="PersonalServerManager.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,40">
            <TextBlock Text="전체 현황" FontSize="27" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <TextBlock Text="서비스 그룹의 운영 상태를 한곳에서 확인합니다."
                       Margin="0,7,0,28" Foreground="{StaticResource MutedTextBrush}" />

            <Border Style="{StaticResource SurfaceCardStyle}" Padding="22,17"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="서비스 그룹" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <Border Background="{StaticResource SubtleSurfaceBrush}"
                            CornerRadius="11" Padding="8,2" Margin="12,0,0,0">
                        <TextBlock Text="0개" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SurfaceCardStyle}" MinHeight="400" Padding="30">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="500">
                    <Border Width="70" Height="70" CornerRadius="20"
                            Background="{StaticResource SubtleSurfaceBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,22">
                        <TextBlock Text="⊞" FontSize="35" FontFamily="Segoe UI Symbol"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="아직 등록된 서비스 그룹이 없습니다"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextAlignment="Center" />
                    <TextBlock Text="그룹을 만들면 여기에서 서버와 데이터베이스의 상태를 확인할 수 있습니다."
                               Margin="0,10,0,24" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Button Content="＋  그룹 만들기" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding CreateGroupCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
