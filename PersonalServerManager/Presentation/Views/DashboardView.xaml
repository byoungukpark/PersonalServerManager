<UserControl x:Class="PersonalServerManager.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,40" MaxWidth="1200" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="전체 현황" FontSize="27" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="저장된 서비스 그룹을 확인합니다."
                               Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="새로고침" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    <Button Content="＋  그룹 만들기" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateGroupCommand}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource SurfaceCardStyle}" Padding="22,17"
                    Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="서비스 그룹" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <Border Background="{StaticResource SubtleSurfaceBrush}"
                            CornerRadius="11" Padding="8,2" Margin="12,0,0,0">
                        <TextBlock Text="{Binding GroupCountText}" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SubtleSurfaceBrush}"
                    BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryTextBrush}" />
            </Border>

            <TextBlock Text="저장된 그룹을 불러오는 중입니다…" Margin="0,0,0,16"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ItemsControl ItemsSource="{Binding Groups}"
                          Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="320" Margin="0,0,16,16">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="Auto" MinHeight="220" Width="320" Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Width="288" Margin="16" HorizontalAlignment="Left">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="  ›" DockPanel.Dock="Right" FontSize="19"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Region}" Margin="0,8,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding AccountId, StringFormat=계정 {0}}"
                                           Margin="0,4,0,18" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EC2 " Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Ec2Count}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,18,0" />
                                    <TextBlock Text="RDS " Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding RdsCount}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,18,0" />
                                    <TextBlock Text="S3 " Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding S3Count}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Statuses}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}" ToolTip="{Binding Detail}"
                                                       Style="{StaticResource GroupStatusTextStyle}"
                                                       FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AccessMessage}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding LastSuccessText}" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                                <TextBlock Text="조회 중…" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                        <Button Content="↻  이 그룹 새로고침" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,6,0,0" HorizontalAlignment="Right"
                                IsEnabled="{Binding CanRefresh}"
                                Command="{Binding DataContext.RefreshGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource SurfaceCardStyle}" MinHeight="400" Padding="30"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="500">
                    <Border Width="70" Height="70" CornerRadius="20"
                            Background="{StaticResource SubtleSurfaceBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,22">
                        <TextBlock Text="⊞" FontSize="35" FontFamily="Segoe UI Symbol"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="아직 등록된 서비스 그룹이 없습니다"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextAlignment="Center" />
                    <TextBlock Text="그룹을 만들면 여기에서 서버와 데이터베이스의 상태를 확인할 수 있습니다."
                               Margin="0,10,0,24" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Button Content="＋  그룹 만들기" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Command="{Binding CreateGroupCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
