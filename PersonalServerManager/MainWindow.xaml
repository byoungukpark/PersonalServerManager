<Window x:Class="PersonalServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:PersonalServerManager.Navigation"
        Title="Personal Server Manager"
        Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="3"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock Text="◈" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource SidebarBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SERVER MANAGER" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="AWS 서비스 그룹 관제" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource SidebarSectionStyle}"
                               Margin="12,0,0,12" />
                    <RadioButton Style="{StaticResource SidebarMenuStyle}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static navigation:AppPage.Dashboard}"
                                 IsChecked="{Binding IsDashboardSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Width="29" FontSize="18" FontFamily="Segoe UI Symbol" />
                            <TextBlock Text="대시보드" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuStyle}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static navigation:AppPage.AwsConnection}"
                                 IsChecked="{Binding IsAwsConnectionSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌁" Width="29" FontSize="18" FontFamily="Segoe UI Symbol" />
                            <TextBlock Text="AWS 연결 관리" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuStyle}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static navigation:AppPage.GroupWorkspace}"
                                 IsChecked="{Binding IsGroupWorkspaceSelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" Width="29" FontSize="18" FontFamily="Segoe UI Symbol" />
                            <TextBlock Text="그룹 만들기" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarMenuStyle}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static navigation:AppPage.History}"
                                 IsChecked="{Binding IsHistorySelected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷" Width="29" FontSize="18" FontFamily="Segoe UI Symbol" />
                            <TextBlock Text="작업 기록" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <RadioButton Grid.Row="3" Style="{StaticResource SidebarMenuStyle}"
                             GroupName="MainNavigation"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="{x:Static navigation:AppPage.Settings}"
                             IsChecked="{Binding IsSettingsSelected, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" Width="29" FontSize="18" FontFamily="Segoe UI Symbol" />
                        <TextBlock Text="설정" />
                    </StackPanel>
                </RadioButton>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Padding="36,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="서비스 그룹 관제" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="14,9"
                        CornerRadius="9" Background="{StaticResource SubtleSurfaceBrush}"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RequiresReconnect}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="SemiBold" />
                        <Border Width="1" Height="17" Background="{StaticResource StrokeBrush}"
                                Margin="14,0" />
                        <TextBlock Text="{Binding ProfileNameText}"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding AccountIdText}" Margin="16,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Grid.Row="1"
                        Content="{Binding CurrentPageViewModel}" />

        <Border Grid.Column="1" Grid.Row="2" Padding="36,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="35" Height="35" CornerRadius="9"
                        Background="{StaticResource SubtleSurfaceBrush}"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="◷" FontSize="18" FontFamily="Segoe UI Symbol"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding ControlActivity}">
                    <TextBlock Text="{Binding Target}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DisplayMessage}" TextWrapping="Wrap"
                               FontSize="12" Style="{StaticResource GroupStatusTextStyle}" />
                    <Expander Header="최근 작업 (최대 5건)" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
