<Application x:Class="PersonalServerManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:PersonalServerManager.Presentation.ViewModels"
             xmlns:views="clr-namespace:PersonalServerManager.Presentation.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/Styles/Colors.xaml" />
                <ResourceDictionary Source="Presentation/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AwsConnectionViewModel}">
                <views:AwsConnectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
